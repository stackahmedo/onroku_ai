{
  "name": "onroku-ai",
  "version": "6.5.0",
  "description": "Onroku AI — Offline multi-speaker Japanese transcription",
  "main": "app/frontend/main.js",
  "homepage": "./",
  "author": "Transcript AI Team",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "wait-on": "^9.0.0"
  },
  "scripts": {
    "react-start":    "react-scripts start",
    "react-build":    "react-scripts build",
    "electron-dev":   "cross-env NODE_ENV=development electron app/frontend/main.js --dev",
    "start":          "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "build":          "npm run react-build",
    "dist":           "npm run react-build && electron-builder",
    "backend":        "cd app/backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "build": {
    "appId": "com.transcriptai.v2",
    "productName": "Onroku AI 6.5",
    "files": [
      "build/**/*",
      "app/frontend/main.js",
      "app/frontend/preload.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
